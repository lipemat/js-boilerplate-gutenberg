# Copy to `jest/.env.local` (gitignored) to run tests which require authentication.
# Generate the password with `wp user application-password create jest-test-user "Js Boilerplate Gutenberg" --porcelain`.
JEST_APP_USER=jest-test-user
JEST_APP_PASSWORD=
# Path to the local site's self-signed certificate.
JEST_CA_CERT=
